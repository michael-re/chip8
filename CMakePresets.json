{
    "version": 9,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/target/debug/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/target/debug/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/target/debug/bin"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/target/release/lib",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/target/release/lib",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/target/release/bin"
            }
        }
    ]
}
